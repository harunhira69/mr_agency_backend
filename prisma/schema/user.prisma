model User {
  id                       String     @id @default(cuid())
  email                    String     @unique @db.VarChar(320)
  passwordHash             String     @db.VarChar(255)
  name                     String     @db.VarChar(120)
  phone                    String?    @db.VarChar(30)
  avatarUrl                String?    @db.Text
  role                     UserRole   @default(CUSTOMER)
  status                   UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt          DateTime?
  twoFactorEnabled         Boolean    @default(false)
  twoFactorSecretEncrypted String?    @db.Text
  failedLoginAttempts      Int        @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  deletedAt                DateTime?

  sessions                  UserSession[]
  authTokens                AuthToken[]
  customerOrders            Order[]            @relation("CustomerOrders")
  assignedOrders            Order[]            @relation("AssignedOrders")
  notifications             NotificationLog[]
  testimonials              Testimonial[]      @relation("CustomerTestimonials")
  blogPosts                 BlogPost[]         @relation("BlogAuthor")
  referralCodes             ReferralCode[]     @relation("ReferralCodeOwner")
  referralsMade             Referral[]         @relation("ReferralReferrer")
  referralsReceived         Referral[]         @relation("ReferralRecipient")
  bulkOrderRequests         BulkOrderRequest[] @relation("BulkRequestCustomer")
  reviewedBulkOrderRequests BulkOrderRequest[] @relation("BulkRequestReviewer")
  supportTickets            SupportTicket[]    @relation("TicketCustomer")
  assignedTickets           SupportTicket[]    @relation("TicketAssignee")
  ticketMessages            TicketMessage[]    @relation("TicketMessageSender")
  auditLogs                 AuditLog[]         @relation("AuditActor")
  updatedSettings           SiteSetting[]      @relation("SettingUpdatedBy")
  uploadedFiles             FileAsset[]        @relation("FileUploader")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.Text
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}
